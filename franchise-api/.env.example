# ---------------------------------------------------------------------------
# Copy this file to .env and adjust the values. .env is git-ignored.
#   cp .env.example .env
#
# The passwords below are for local development only. On any shared or
# public server replace them with long random values, e.g.:
#   openssl rand -base64 24
# ---------------------------------------------------------------------------

# --- MySQL -----------------------------------------------------------------
DB_NAME=franchise_db
DB_USERNAME=franchise_user
DB_PASSWORD=franchise_password
DB_PORT=3306

# JDBC connection security options.
#   Compose MySQL (no TLS)    : useSSL=false&allowPublicKeyRetrieval=true
#   Managed cloud MySQL (TLS) : sslMode=REQUIRED
DB_PARAMS=useSSL=false&allowPublicKeyRetrieval=true

# Used only to bootstrap the MySQL container and by its healthcheck.
MYSQL_ROOT_PASSWORD=root_password

# --- Application -----------------------------------------------------------
# Host where the API looks for MySQL.
#   localhost -> running the app with `mvn spring-boot:run`
#   mysql     -> running the app as a Compose service (set automatically)
DB_HOST=localhost
SERVER_PORT=8080

# Swagger UI and /v3/api-docs. Set to false to hide them in production.
SWAGGER_ENABLED=true

# Host port the API is published on by Docker Compose.
API_PORT=8080

# Image used by docker-compose.prod.yml (published by GitHub Actions).
API_IMAGE=ghcr.io/alejovl04/franchise-api:latest

# --- JVM -------------------------------------------------------------------
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
